<div class="row g-3">
  <div class="col-md-3">
    <label class="form-label">Folio</label>
    <p class="form-control-plaintext fw-bold ps-2" style="border:1px solid var(--input-border,#ccc);border-radius:.375rem;padding:.375rem .75rem;background:var(--input-bg,rgba(0,0,0,.04))">
      {{ nota is defined and nota.folio is defined ? nota.folio : 'Se generará automáticamente' }}
    </p>
  </div>
  <div class="col-md-9">{{ form_row(form.title) }}</div>
  <div class="col-md-6">{{ form_row(form.area) }}</div>
  <div class="col-md-3">{{ form_row(form.fechaLimite) }}</div>
  <div class="col-md-3">{{ form_row(form.status) }}</div>
  <div class="col-md-6">{{ form_row(form.user) }}</div>
  <div class="col-12">{{ form_row(form.content) }}</div>
  <div class="col-md-6">{{ form_row(form.file_path) }}</div>
</div>
<p class="text-muted small mt-2"><span class="text-danger">*</span> Campo obligatorio</p>
