{% extends 'base.html.twig' %}
{% block title %}Editar Nota Informativa{% endblock %}
{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Editar Nota Informativa</h1>
    <div class="glass-actions">
      <a href="{{ path('app_nota_informativa_show', {'id': nota.id}) }}" class="glass-btn">
        <i class="bi bi-eye"></i> Ver
      </a>
      <a href="{{ path('app_nota_informativa_index') }}" class="glass-btn" style="border-color:#B28E5C;color:#B28E5C">
        <i class="bi bi-arrow-left"></i> Regresar
      </a>
    </div>
  </div>
  <div class="glass-card">
    {{ form_start(form, { attr: { class: 'form-glass' } }) }}
      {{ include('nota_informativa/_form.html.twig') }}
      <div class="form-actions mt-3">
        <button class="glass-btn primary" type="submit">
          <i class="bi bi-save"></i> Guardar cambios
        </button>
      </div>
    {{ form_end(form) }}
  </div>
  {% if is_granted('ROLE_ADMIN') %}
    <div class="mt-3">
      <form id="del-nota-edit-{{ nota.id }}" method="post" action="{{ path('app_nota_informativa_delete', {'id': nota.id}) }}" style="display:none">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ nota.id) }}">
      </form>
      <button type="button" class="btn btn-outline-danger btn-sm"
              data-delete-form="del-nota-edit-{{ nota.id }}"
              data-confirm-msg="¿Eliminar la nota {{ nota.folio ?? '#' ~ nota.id }}? Esta acción no se puede deshacer.">
        <i class="bi bi-trash"></i> Eliminar
      </button>
    </div>
  {% endif %}
</div>
{% endblock %}
