{% extends 'base.html.twig' %}
{% block title %}Nueva Nota Informativa{% endblock %}
{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Nueva Nota Informativa</h1>
    <a href="{{ path('app_nota_informativa_index') }}" class="glass-btn">
      <i class="bi bi-arrow-left"></i> Volver
    </a>
  </div>
  <div class="glass-card">
    {{ form_start(form, { attr: { class: 'form-glass' } }) }}
      {{ include('nota_informativa/_form.html.twig') }}
      <div class="form-actions mt-3">
        <button class="glass-btn primary" type="submit">
          <i class="bi bi-save"></i> Guardar
        </button>
      </div>
    {{ form_end(form) }}
  </div>
</div>
{% endblock %}
