{% extends 'base.html.twig' %}

{% block title %}Escáner{% endblock %}
{% block body %}
<div class="container-glass js-table-wrapper">

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Documentos Escaneados</h1>

    <div class="glass-actions">
      <a href="{{ path('app_scanner_export') }}" class="glass-btn success">
        <i class="bi bi-download"></i> Exportar a Excel
      </a>
      <a href="{{ path('app_scanner_new') }}" class="glass-btn primary">
        <i class="bi bi-plus-circle"></i> Subir escaneo
      </a>
    </div>
  </div>

  <div class="toolbar js-table-toolbar">
    <input type="text" class="js-search form-input" placeholder="Buscar en la tabla…">
    <select class="js-stage form-select">
      <option value="todos">Todas las etapas</option>
      <option value="finalizado">Finalizado</option>
      <option value="pendiente">Pendiente</option>
      <option value="error">Error</option>
    </select>
  </div>

  <div class="table-responsive">
    <table class="table-glass js-enhanced-table">
      <thead>
        <tr>
          <th>Folio</th>
          <th>Área / Departamento</th>
          <th>Estado</th>
          <th>Usuario responsable</th>
          <th>Fecha subida</th>
          <th class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody>
      {% for scan in scanners %}
        {% set estado = (scan.status ?? 'pendiente')|lower %}
        {% set row_text = ((scan.numDocumento ?? scan.id) ~ ' ' ~ scan.name ~ ' ' ~ (scan.tipoDocumento ?? scan.sourceType ?? '') ~ ' ' ~ scan.status)|lower %}

        <tr data-stage="{{ estado }}" data-text="{{ row_text }}">
          <td data-label="Folio">
            <strong>{{ scan.numDocumento ?? ('#' ~ scan.id) }}</strong>
            <div class="text-muted small">{{ scan.name|default('') }}</div>
          </td>
          <td data-label="Área">{{ scan.tipoDocumento ?? scan.sourceType|default('—') }}</td>
          <td data-label="Estado">
            <span class="pill-badge {{ estado }}">{{ estado|capitalize }}</span>
          </td>
          <td data-label="Usuario">
            {% if scan.user %}
              {{ scan.user.nombre ?? scan.user.email }}
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
          </td>
          <td data-label="Fecha subida">{{ scan.createdAt ? scan.createdAt|date('d/m/Y') : '—' }}</td>
          <td data-label="Acciones" class="text-center">
            {% if scan.filePath %}
              <a href="{{ asset(scan.filePath) }}" target="_blank" class="btn btn-outline-primary btn-sm" title="Ver archivo">
                <i class="bi bi-file-earmark-pdf"></i>
              </a>
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
              <form method="post" action="{{ path('app_scanner_delete', {'id': scan.id}) }}"
                    style="display:inline"
                    onsubmit="return confirm('¿Eliminar este escaneo?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ scan.id) }}">
                <button class="btn btn-outline-danger btn-sm" title="Eliminar">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            {% endif %}
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="6" class="text-center text-muted py-4">Sin información</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="js-counter table-counter">&nbsp;</div>
</div>
{% endblock %}
