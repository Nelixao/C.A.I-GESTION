{% extends 'baselogin.html.twig' %}

{% block title %}Crear cuenta — C.A.I.{% endblock %}

{% block body %}
    <h1>Crear cuenta</h1>
    <p class="subtitle">Completa tus datos para registrarte</p>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="auth-{{ label == 'success' ? 'success' : 'error' }} mb-3">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <form method="post" action="{{ path('app_register') }}" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

        <div class="field">
            <label for="nombre">Nombre completo</label>
            <div class="field-wrap">
                <i class="bi bi-person fi"></i>
                <input type="text" id="nombre" name="nombre"
                       placeholder="Tu nombre completo"
                       autocomplete="name" required>
            </div>
        </div>

        <div class="field">
            <label for="email">Correo electrónico</label>
            <div class="field-wrap">
                <i class="bi bi-envelope fi"></i>
                <input type="email" id="email" name="email"
                       placeholder="correo@ejemplo.com"
                       autocomplete="email" required>
            </div>
        </div>

        <div class="field">
            <label for="password">Contraseña</label>
            <div class="field-wrap">
                <i class="bi bi-lock fi"></i>
                <input type="password" id="password" name="password"
                       placeholder="Mínimo 6 caracteres"
                       autocomplete="new-password" required>
            </div>
        </div>

        <button type="submit" class="btn-auth mt-2">
            <i class="bi bi-person-plus"></i>
            Crear mi cuenta
        </button>
    </form>
{% endblock %}

{% block auth_footer %}
    <p class="auth-footer-link mt-3">
        ¿Ya tienes cuenta? <a href="{{ path('app_login') }}">Inicia sesión</a>
    </p>
{% endblock %}
