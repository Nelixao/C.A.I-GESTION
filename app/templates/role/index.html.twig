{% extends 'base.html.twig' %}

{% block title %}Roles{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Roles del Sistema</h1>
    <a href="{{ path('app_role_new') }}" class="glass-btn primary">
      <i class="bi bi-plus-circle"></i> Nuevo Rol
    </a>
  </div>

  <div class="table-responsive">
    <table class="table-glass">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre del Rol</th>
          <th class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody>
      {% for role in roles %}
        <tr>
          <td>{{ role.id }}</td>
          <td><strong>{{ role.name }}</strong></td>
          <td class="text-center">
            <a href="{{ path('app_role_show', {'id': role.id}) }}" class="btn btn-outline-primary btn-sm" title="Ver">
              <i class="bi bi-eye"></i>
            </a>
            <a href="{{ path('app_role_edit', {'id': role.id}) }}" class="btn btn-outline-warning btn-sm" title="Editar">
              <i class="bi bi-pencil-square"></i>
            </a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="3" class="text-center text-muted py-4">
            <i class="bi bi-shield-lock fs-3 d-block mb-2 opacity-50"></i>
            No hay roles registrados aún. <a href="{{ path('app_role_new') }}" class="text-decoration-none">¡Crea el primero!</a>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
