<form id="delete-role-{{ role.id }}" method="post" action="{{ path('app_role_delete', {'id': role.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
</form>
<button type="button" class="btn btn-outline-danger btn-sm"
        data-delete-form="delete-role-{{ role.id }}"
        data-confirm-msg="¿Eliminar el rol {{ role.name }}? Esta acción no se puede deshacer."
        title="Eliminar">
    <i class="bi bi-trash"></i> Eliminar
</button>
