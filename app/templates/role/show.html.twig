{% extends 'base.html.twig' %}

{% block title %}Rol: {{ role.name }}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Rol: {{ role.name }}</h1>
    <div class="glass-actions">
      <a href="{{ path('app_role_edit', {'id': role.id}) }}" class="glass-btn primary">
        <i class="bi bi-pencil-square"></i> Editar
      </a>
      <a href="{{ path('app_role_index') }}" class="glass-btn" style="border-color:#B28E5C;color:#B28E5C">
        <i class="bi bi-arrow-left"></i> Regresar
      </a>
    </div>
  </div>

  <div class="glass-card">
    <table class="table table-borderless">
      <tbody>
        <tr><th style="width:150px">ID</th><td>{{ role.id }}</td></tr>
        <tr><th>Nombre</th><td>{{ role.name }}</td></tr>
      </tbody>
    </table>
  </div>

  {% if is_granted('ROLE_ADMIN') %}
    <div class="mt-3">{{ include('role/_delete_form.html.twig') }}</div>
  {% endif %}
</div>
{% endblock %}
