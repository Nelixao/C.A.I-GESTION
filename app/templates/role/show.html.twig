{% extends 'base.html.twig' %}

{% block title %}Rol — {{ role.name }}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title"><i class="bi bi-shield-lock me-2"></i>{{ role.name }}</h1>
    <div class="glass-actions">
      <a href="{{ path('app_role_index') }}" class="glass-btn">
        <i class="bi bi-arrow-left"></i> Listado
      </a>
      <a href="{{ path('app_role_edit', {'id': role.id}) }}" class="glass-btn primary">
        <i class="bi bi-pencil"></i> Editar
      </a>
    </div>
  </div>

  <div class="glass-card">
    <div class="row g-3">
      <div class="col-md-4">
        <div class="detail-label">ID</div>
        <div class="detail-value fw-bold">{{ role.id }}</div>
      </div>
      <div class="col-md-8">
        <div class="detail-label">Nombre del Rol</div>
        <div class="detail-value fw-semibold">{{ role.name }}</div>
      </div>
    </div>
  </div>

  <div class="mt-3">
    {{ include('role/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
