{% extends 'base.html.twig' %}

{% block title %}Nuevo Rol{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Crear Nuevo Rol</h1>
    <a href="{{ path('app_role_index') }}" class="glass-btn" style="border-color:#B28E5C;color:#B28E5C">
      <i class="bi bi-arrow-left"></i> Regresar
    </a>
  </div>
  <div class="glass-card">
    {{ form_start(form, { attr: { class: 'form-glass' } }) }}
      <div class="row g-3">
        <div class="col-12">{{ form_row(form) }}</div>
      </div>
      <div class="form-actions mt-3">
        <button class="glass-btn primary" type="submit">
          <i class="bi bi-save"></i> Guardar
        </button>
      </div>
    {{ form_end(form) }}
  </div>
</div>
{% endblock %}
