{% extends 'base.html.twig' %}

{% block title %}Informes{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .informes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.25rem;
    }
    /* Unificado con .dash-card del Dashboard */
    .informe-card {
      background: var(--bg-card, rgba(255,255,255,.08));
      border: 1px solid var(--border-color, rgba(255,255,255,.12));
      border-radius: 16px;
      padding: 1.25rem;
      box-shadow: var(--glass-shadow, 0 4px 24px rgba(0,0,0,.12));
      backdrop-filter: blur(12px);
    }
    .informe-card h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary, inherit);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .chart-box { position: relative; height: 280px; }
    .export-btn {
      font-size: 0.78rem;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(30,91,79,.15);
      color: #2e8b6e;
      border: 1px solid #2e8b6e;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
      font-weight: 600;
      transition: background .2s, color .2s;
    }
    .export-btn:hover { background: #1e5b4f; color: #fff !important; }
    /* Totales table */
    .totales-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .totales-table td { padding: 8px 12px; border-bottom: 1px solid var(--border-color, rgba(0,0,0,.07)); color: var(--text-primary, inherit); }
    .totales-table td:last-child { text-align: right; font-weight: 700; color: #9b2247; }
    .totales-table tr:last-child td { border-bottom: none; }
    .page-title { font-size: 1.6rem; font-weight: 800; }
  </style>
{% endblock %}

{% block body %}
<div class="container-glass" style="max-width:1400px">

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
    <h1 class="page-title">Informes del Sistema</h1>
    <div class="glass-actions">
      <a href="{{ path('app_informes_export_modulos') }}" class="glass-btn success">
        <i class="bi bi-download"></i> Excel: Módulos
      </a>
      <a href="{{ path('app_informes_export_estados') }}" class="glass-btn success">
        <i class="bi bi-download"></i> Excel: Estados
      </a>
      <a href="{{ path('app_informes_export_areas') }}" class="glass-btn success">
        <i class="bi bi-download"></i> Excel: Áreas
      </a>
    </div>
  </div>

  <div class="informes-grid">

    {# ── Totales por módulo ─────────────────────────────────── #}
    <div class="informe-card">
      <h3>
        <span><i class="bi bi-bar-chart-fill"></i> Total por módulo</span>
        <a href="{{ path('app_informes_export_modulos') }}" class="export-btn">
          <i class="bi bi-file-earmark-excel"></i> Exportar
        </a>
      </h3>
      <div class="chart-box">
        <canvas id="chartModulos"></canvas>
      </div>
    </div>

    {# ── Distribución de estados ────────────────────────────── #}
    <div class="informe-card">
      <h3>
        <span><i class="bi bi-pie-chart-fill"></i> Documentos por estado</span>
        <a href="{{ path('app_informes_export_estados') }}" class="export-btn">
          <i class="bi bi-file-earmark-excel"></i> Exportar
        </a>
      </h3>
      <div class="chart-box">
        <canvas id="chartEstados"></canvas>
      </div>
    </div>

    {# ── Documentos por área / remitente ────────────────────── #}
    <div class="informe-card">
      <h3>
        <span><i class="bi bi-people-fill"></i> Oficios por remitente (top 10)</span>
        <a href="{{ path('app_informes_export_areas') }}" class="export-btn">
          <i class="bi bi-file-earmark-excel"></i> Exportar
        </a>
      </h3>
      <div class="chart-box">
        <canvas id="chartAreas"></canvas>
      </div>
    </div>

    {# ── Tabla totales ──────────────────────────────────────── #}
    <div class="informe-card">
      <h3><span><i class="bi bi-table"></i> Resumen de totales</span></h3>
      <table class="totales-table">
        {% for modulo, total in totalesPorModulo %}
          <tr>
            <td>{{ modulo }}</td>
            <td>{{ total }}</td>
          </tr>
        {% endfor %}
      </table>
    </div>

  </div>{# /grid #}

  {# ── Detalle por estado (tablas por módulo) ─────────────── #}
  <div class="informes-grid">
    {% for modulo, estados in estadosPorModulo %}
      {% if estados is not empty %}
        <div class="informe-card">
          <h3><i class="bi bi-tag-fill"></i> {{ modulo }} — por estado</h3>
          <table class="totales-table">
            {% for estado, total in estados %}
              <tr>
                <td>
                  <span class="pill-badge {{ estado|lower|replace({' ': '-'}) }}">{{ estado }}</span>
                </td>
                <td>{{ total }}</td>
              </tr>
            {% else %}
              <tr><td colspan="2" class="text-muted text-center">Sin datos</td></tr>
            {% endfor %}
          </table>
        </div>
      {% endif %}
    {% endfor %}
  </div>

</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
  (function(){
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    const textColor = isDark ? '#b4bccb' : '#3d4457';
    const gridColor = isDark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.06)';

    Chart.defaults.color = textColor;
    Chart.defaults.borderColor = gridColor;

    function showEmpty(canvasId, msg) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      canvas.style.display = 'none';
      const p = document.createElement('p');
      p.className = 'text-muted text-center py-4';
      p.style.fontSize = '0.88rem';
      p.textContent = msg || 'Sin datos registrados';
      canvas.parentElement.appendChild(p);
    }

    // ── Totales por módulo (barras) ──────────────────────────
    const modLabels = {{ totalesPorModulo|keys|json_encode|raw }};
    const modData   = {{ totalesPorModuloValues|json_encode|raw }};
    if (modData.some(v => v > 0)) {
      new Chart(document.getElementById('chartModulos'), {
        type: 'bar',
        data: {
          labels: modLabels,
          datasets: [{
            label: 'Documentos',
            data: modData,
            backgroundColor: ['#a57f2c','#9b2247','#1e5b4f','#c0392b','#6c3483','#2471a3'],
            borderRadius: 6,
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
      });
    } else {
      showEmpty('chartModulos', 'Sin datos registrados en ningún módulo');
    }

    // ── Distribución de estados (dona) ───────────────────────
    const stLabels = {{ globalStatuses|keys|json_encode|raw }};
    const stData   = {{ globalStatusesValues|json_encode|raw }};
    const stColors = ['#a57f2c','#9b2247','#1e5b4f','#c0392b','#6c3483','#2471a3','#148f77','#d4ac0d'];
    if (stData.some(v => v > 0)) {
      new Chart(document.getElementById('chartEstados'), {
        type: 'doughnut',
        data: {
          labels: stLabels,
          datasets: [{
            data: stData,
            backgroundColor: stColors.slice(0, stLabels.length),
            borderWidth: 2,
            borderColor: isDark ? '#0e1114' : '#f4f6fa',
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10 } }
          }
        }
      });
    } else {
      showEmpty('chartEstados', 'Sin datos de estados registrados');
    }

    // ── Áreas / remitentes (barras horizontales) ─────────────
    {% set areasOficio = areasPorModulo['Oficios'] ?? [] %}
    const arLabels = {{ areasOficio|map(r => r.area)|json_encode|raw }};
    const arData   = {{ areasOficio|map(r => r.total)|json_encode|raw }};
    if (arData.length > 0 && arData.some(v => v > 0)) {
      new Chart(document.getElementById('chartAreas'), {
        type: 'bar',
        data: {
          labels: arLabels,
          datasets: [{
            label: 'Oficios',
            data: arData,
            backgroundColor: '#9b2247',
            borderRadius: 4,
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
        }
      });
    } else {
      showEmpty('chartAreas', 'Sin datos de remitentes registrados');
    }
  })();
  </script>
{% endblock %}
