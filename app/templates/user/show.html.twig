{% extends 'base.html.twig' %}

{% block title %}Usuario — {{ user.nombre ?? user.email }}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title"><i class="bi bi-person-circle me-2"></i>{{ user.nombre ?? user.email }}</h1>
    <div class="glass-actions">
      <a href="{{ path('app_user_index') }}" class="glass-btn">
        <i class="bi bi-arrow-left"></i> Listado
      </a>
      <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="glass-btn primary">
        <i class="bi bi-pencil"></i> Editar
      </a>
    </div>
  </div>

  <div class="glass-card">
    <div class="row g-3">

      <div class="col-md-4">
        <div class="detail-label">ID</div>
        <div class="detail-value fw-bold">{{ user.id }}</div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Nombre</div>
        <div class="detail-value">{{ user.nombre ?? '—' }}</div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Email</div>
        <div class="detail-value">{{ user.email }}</div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Rol</div>
        <div class="detail-value">
          <span class="badge bg-secondary-subtle text-secondary-emphasis">{{ user.rol ?? 'Invitado' }}</span>
        </div>
      </div>

      {% if user.role %}
      <div class="col-md-4">
        <div class="detail-label">Rol del sistema</div>
        <div class="detail-value">{{ user.role.name }}</div>
      </div>
      {% endif %}

      <div class="col-md-4">
        <div class="detail-label">Cuenta creada</div>
        <div class="detail-value">{{ user.fechaCreacion ? user.fechaCreacion|date('d/m/Y H:i') : '—' }}</div>
      </div>

    </div>
  </div>

  <div class="mt-3">
    {{ include('user/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
