<form id="delete-user-{{ user.id }}" method="post" action="{{ path('app_user_delete', {'id': user.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
</form>
<button type="button" class="btn btn-outline-danger btn-sm"
        data-delete-form="delete-user-{{ user.id }}"
        data-confirm-msg="¿Eliminar al usuario {{ user.nombre ?? user.email }}? Esta acción no se puede deshacer."
        title="Eliminar">
    <i class="bi bi-trash"></i> Eliminar
</button>
