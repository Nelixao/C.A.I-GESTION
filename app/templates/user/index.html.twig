{% extends 'base.html.twig' %}

{% block title %}Usuarios{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Usuarios del Sistema</h1>
    <a href="{{ path('app_user_new') }}" class="glass-btn primary">
      <i class="bi bi-plus-circle"></i> Nuevo Usuario
    </a>
  </div>

  <div class="table-responsive">
    <table class="table-glass">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Email</th>
          <th class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody>
      {% for user in users %}
        <tr>
          <td>{{ user.id }}</td>
          <td><strong>{{ user.nombre }}</strong></td>
          <td>{{ user.email ?? '—' }}</td>
          <td class="text-center">
            <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-outline-primary btn-sm" title="Ver">
              <i class="bi bi-eye"></i>
            </a>
            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-outline-warning btn-sm" title="Editar">
              <i class="bi bi-pencil-square"></i>
            </a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4" class="text-center text-muted py-4">
            <i class="bi bi-people fs-3 d-block mb-2 opacity-50"></i>
            No hay usuarios registrados aún. <a href="{{ path('app_user_new') }}" class="text-decoration-none">¡Crea el primero!</a>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
