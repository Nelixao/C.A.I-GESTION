{{ form_start(form, { attr: { class: 'form-glass' } }) }}
  <div class="row g-3">

    <div class="col-md-6">
      {{ form_row(form.email) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.nombre) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.contrasena) }}
    </div>

    <div class="col-md-3">
      {{ form_row(form.rol) }}
    </div>

    <div class="col-md-3">
      {{ form_row(form.role) }}
    </div>

  </div>
  <div class="form-actions mt-4">
    <button class="glass-btn primary" type="submit">
      <i class="bi bi-save"></i> {{ button_label|default('Guardar') }}
    </button>
  </div>
{{ form_end(form) }}
