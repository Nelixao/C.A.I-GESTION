<form id="delete-correspondence-{{ correspondence.id }}" method="post" action="{{ path('app_correspondence_delete', {'id': correspondence.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ correspondence.id) }}">
</form>
<button type="button" class="btn btn-outline-danger btn-sm"
        data-delete-form="delete-correspondence-{{ correspondence.id }}"
        data-confirm-msg="¿Eliminar esta correspondencia? Esta acción no se puede deshacer."
        title="Eliminar">
    <i class="bi bi-trash"></i> Eliminar
</button>
