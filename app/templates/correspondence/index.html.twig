{% extends 'base.html.twig' %}

{% block title %}Correspondencia{% endblock %}

{% block stylesheets %}{% endblock %}
{% block body %}
<div class="container-glass">

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Listado de Correspondencia</h1>

    <div class="glass-actions">
      <a href="{{ path('app_correspondence_export') }}" class="glass-btn success">
        <i class="bi bi-download"></i> Exportar a Excel
      </a>
      <a href="{{ path('app_correspondence_new') }}" class="glass-btn primary">
        <i class="bi bi-plus-circle"></i> Crear nueva
      </a>
    </div>
  </div>

  <div class="js-table-wrapper">
    <div class="toolbar js-table-toolbar">
      <input type="text" class="js-search form-input" placeholder="Buscar en la tabla...">
      <select class="js-stage form-select">
        <option value="todos">Todos los estados</option>
        <option value="pendiente">Pendiente</option>
        <option value="en trámite">En trámite</option>
        <option value="concluido">Concluido</option>
        <option value="archivado">Archivado</option>
      </select>
    </div>

    <div class="table-responsive">
      <table class="table-glass js-enhanced-table">
        <thead>
          <tr>
            <th>Folio</th>
            <th>Área / Departamento</th>
            <th>Estado</th>
            <th>Usuario responsable</th>
            <th>Fecha límite</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
        {% for correspondence in correspondences %}
          {% set estado = (correspondence.status ?? 'pendiente')|lower %}
          {% set row_text = ((correspondence.numControl ?? correspondence.id) ~ ' ' ~ correspondence.subject ~ ' ' ~ correspondence.sender ~ ' ' ~ correspondence.status)|lower %}

          <tr data-stage="{{ estado }}" data-text="{{ row_text }}">
            <td data-label="Folio">
              <strong>{{ correspondence.numControl ?? ('#' ~ correspondence.id) }}</strong>
              <div class="text-muted small">{{ correspondence.subject|default('') }}</div>
            </td>
            <td data-label="Área">{{ correspondence.sender|default('—') }}</td>
            <td data-label="Estado">
              <span class="pill-badge {{ estado }}">{{ correspondence.status|default('Pendiente') }}</span>
            </td>
            <td data-label="Usuario">
              {% if correspondence.user %}
                {{ correspondence.user.nombre ?? correspondence.user.email }}
              {% else %}
                <span class="text-muted">—</span>
              {% endif %}
            </td>
            <td data-label="Fecha límite">{{ correspondence.date ? correspondence.date|date('d/m/Y') : '—' }}</td>
            <td data-label="Acciones" class="text-center">
              <a href="{{ path('app_correspondence_show', {'id': correspondence.id}) }}" class="btn btn-outline-primary btn-sm" title="Ver">
                <i class="bi bi-eye"></i>
              </a>
              <a href="{{ path('app_correspondence_edit', {'id': correspondence.id}) }}" class="btn btn-outline-warning btn-sm" title="Editar">
                <i class="bi bi-pencil-square"></i>
              </a>
              {% if is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('app_correspondence_delete', {'id': correspondence.id}) }}"
                      style="display:inline"
                      onsubmit="return confirm('¿Eliminar esta correspondencia?')">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ correspondence.id) }}">
                  <button class="btn btn-outline-danger btn-sm" title="Eliminar">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="text-center text-muted py-4">SIN INFORMACIÓN</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="js-counter table-counter">&nbsp;</div>
  </div>

  <a href="{{ path('app_correspondence_new') }}" class="glass-btn primary float-btn">
    <i class="bi bi-plus-lg"></i> Crear nueva
  </a>
</div>
{% endblock %}
