{% extends 'base.html.twig' %}

{% block title %}Circulares{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Listado de Circulares</h1>

    <a href="{{ path('app_circular_new') }}" class="glass-btn primary mt-3 mt-md-0">
      <i class="bi bi-plus-circle"></i> Nueva Circular
    </a>
  </div>

  <div class="js-table-wrapper">
    <div class="toolbar js-table-toolbar">
      <input type="text" class="js-search form-input" placeholder="Buscar en la tabla...">
      <select class="js-stage form-select">
        <option value="todos">Todos los estados</option>
        <option value="pendiente">Pendiente</option>
        <option value="en trámite">En trámite</option>
        <option value="concluido">Concluido</option>
        <option value="archivado">Archivado</option>
      </select>
    </div>

    <div class="table-responsive">
      <table class="table-glass js-enhanced-table">
        <thead>
          <tr>
            <th>Folio</th>
            <th>Área / Departamento</th>
            <th>Estado</th>
            <th>Usuario responsable</th>
            <th>Fecha límite</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for circular in circulars %}
            {% set estado = (circular.status ?? 'pendiente')|lower %}
            {% set row_text = ((circular.numCircular ?? circular.id) ~ ' ' ~ circular.title ~ ' ' ~ circular.targetGroup ~ ' ' ~ circular.status)|lower %}

            <tr data-stage="{{ estado }}" data-text="{{ row_text }}">
              <td data-label="Folio">
                <strong>{{ circular.numCircular ?? ('#' ~ circular.id) }}</strong>
                <div class="text-muted small">{{ circular.title|default('') }}</div>
              </td>
              <td data-label="Área">{{ circular.targetGroup|default('—') }}</td>
              <td data-label="Estado">
                <span class="pill-badge {{ estado }}">{{ circular.status|default('Pendiente') }}</span>
              </td>
              <td data-label="Usuario">
                {% if circular.user %}
                  {{ circular.user.nombre ?? circular.user.email }}
                {% else %}
                  <span class="text-muted">—</span>
                {% endif %}
              </td>
              <td data-label="Fecha límite">{{ circular.date ? circular.date|date('d/m/Y') : '—' }}</td>
              <td data-label="Acciones" class="text-center">
                <a href="{{ path('app_circular_show', {'id': circular.id}) }}" class="btn btn-outline-primary" title="Ver">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('app_circular_edit', {'id': circular.id}) }}" class="btn btn-outline-warning" title="Editar">
                  <i class="bi bi-pencil-square"></i>
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                  <form method="post" action="{{ path('app_circular_delete', {'id': circular.id}) }}"
                        style="display:inline"
                        onsubmit="return confirm('¿Eliminar esta circular?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ circular.id) }}">
                    <button class="btn btn-outline-danger btn-sm" title="Eliminar">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="text-center text-muted py-4">Sin información</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="js-counter table-counter">&nbsp;</div>
  </div>
</div>
{% endblock %}

