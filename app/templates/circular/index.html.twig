{% extends 'base.html.twig' %}

{% block title %}Circulares{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Listado de Circulares</h1>

    <a href="{{ path('app_circular_new') }}" class="glass-btn primary mt-3 mt-md-0">
      <i class="bi bi-plus-circle"></i> Nueva Circular
    </a>
  </div>

  <div class="js-table-wrapper">
    <div class="toolbar js-table-toolbar">
      <input type="text" class="js-search form-input" placeholder="Buscar en la tabla...">
      <select class="js-stage form-select">
        <option value="todos">Todos los estados</option>
        <option value="abierta">Abierta</option>
        <option value="en trámite">En Trámite</option>
        <option value="cerrada">Cerrada</option>
        <option value="archivada">Archivada</option>
      </select>
    </div>

    <div class="table-responsive">
      <table class="table-glass js-enhanced-table">
        <thead>
          <tr>
            <th>Folio</th>
            <th>Asunto</th>
            <th>Dirigido a</th>
            <th>Recibido por</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for circular in circulars %}
            {% set estado = (circular.status ?? 'abierta')|lower %}
            {% set row_text = (circular.folio ~ ' ' ~ circular.asunto ~ ' ' ~ circular.targetGroup ~ ' ' ~ circular.recibidoPor ~ ' ' ~ circular.status)|lower %}

            <tr data-stage="{{ estado }}" data-text="{{ row_text }}">
              <td data-label="Folio">
                <strong>{{ circular.folio ?? ('#' ~ circular.id) }}</strong>
              </td>
              <td data-label="Asunto">{{ circular.asunto|default('—') }}</td>
              <td data-label="Dirigido a">{{ circular.targetGroup|default('—') }}</td>
              <td data-label="Recibido por">{{ circular.recibidoPor|default('—') }}</td>
              <td data-label="Fecha">{{ circular.date ? circular.date|date('d/m/Y') : '—' }}</td>
              <td data-label="Estado">
                <span class="pill-badge {{ estado }}">{{ circular.status|default('Abierta') }}</span>
              </td>
              <td data-label="Acciones" class="text-center">
                <a href="{{ path('app_circular_show', {'id': circular.id}) }}" class="btn btn-outline-primary btn-sm" title="Ver">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('app_circular_edit', {'id': circular.id}) }}" class="btn btn-outline-warning btn-sm" title="Editar">
                  <i class="bi bi-pencil-square"></i>
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                  <form id="del-circular-{{ circular.id }}" method="post" action="{{ path('app_circular_delete', {'id': circular.id}) }}" style="display:none">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ circular.id) }}">
                  </form>
                  <button type="button" class="btn btn-outline-danger btn-sm" title="Eliminar"
                          data-delete-form="del-circular-{{ circular.id }}"
                          data-confirm-msg="¿Eliminar la circular {{ circular.folio ?? '#' ~ circular.id }}?">
                    <i class="bi bi-trash"></i>
                  </button>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                No hay circulares aún. <a href="{{ path('app_circular_new') }}" class="text-decoration-none">¡Crea la primera!</a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="js-counter table-counter">&nbsp;</div>
  </div>
</div>
{% endblock %}
