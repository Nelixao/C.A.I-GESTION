{% extends 'base.html.twig' %}

{% block title %}Circulares{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Listado de Circulares</h1>

    <a href="{{ path('app_circular_new') }}" class="glass-btn primary mt-3 mt-md-0">
      <i class="bi bi-plus-circle"></i> Nueva Circular
    </a>
  </div>

  <div class="js-table-wrapper">
    <div class="toolbar js-table-toolbar">
      <input type="text" class="js-search form-input" placeholder="Buscar en la tabla...">
      <select class="js-stage form-select">
        <option value="todos">Todas las etapas</option>
        <option value="abierta">Abierta</option>
        <option value="en_tramite">En trámite</option>
        <option value="cerrada">Cerrada</option>
        <option value="archivada">Archivada</option>
      </select>
    </div>

    <div class="table-responsive">
      <table class="table-glass js-enhanced-table">
        <thead>
          <tr>
            <th>FOLIO</th>
            <th>FECHA</th>
            <th>ASUNTO</th>
            <th>ESTADO</th>
            <th>FECHA LÍMITE</th>
            <th>RESPONSABLE</th>
            <th class="text-center">ACCIÓN</th>
          </tr>
        </thead>
        <tbody>
          {% for circular in circulars %}
            {% set estado = circular.estado|lower %}
            {% set row_text = (circular.id ~ ' ' ~ circular.numCircular ~ ' ' ~ circular.titulo ~ ' ' ~ circular.contenido)|lower %}

            <tr data-stage="{{ estado }}" data-text="{{ row_text }}" data-asunto="{{ circular.titulo|lower }}">
              <td data-label="Folio">#{{ circular.numCircular }}</td>
              <td data-label="Fecha">{{ circular.fecha ? circular.fecha|date('d-m-Y') : '' }}</td>
              <td data-label="Asunto">{{ circular.titulo|default('—') }}</td>

              <td data-label="Estado">
                <span class="pill-badge {{ estado }}">{{ circular.estado|capitalize }}</span>
              </td>

              <td data-label="Fecha límite">{{ circular.fechaLimite ? circular.fechaLimite|date('d-m-Y') : '—' }}</td>
              <td data-label="Responsable">{{ circular.user ? (circular.user.nombre ?? circular.user.email) : '—' }}</td>

              <td data-label="Acción" class="text-center">
                <a href="{{ path('app_circular_show', {'id': circular.id}) }}" class="btn btn-outline-primary" title="Ver">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('app_circular_edit', {'id': circular.id}) }}" class="btn btn-outline-warning" title="Editar">
                  <i class="bi bi-pencil-square"></i>
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="text-center text-muted py-4">Sin información</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="js-counter table-counter">&nbsp;</div>
  </div>
</div>
{% endblock %}
