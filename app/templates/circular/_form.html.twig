{{ form_start(form, { attr: { class: 'form-glass' } }) }}
  <div class="row g-3">

    <div class="col-md-6">
      {{ form_row(form.numCircular) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.fecha) }}
    </div>

    <div class="col-12">
      {{ form_row(form.titulo) }}
    </div>

    <div class="col-12">
      {{ form_row(form.contenido) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.estado) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.fechaLimite) }}
    </div>

    <div class="col-md-6">
      {{ form_row(form.user) }}
    </div>

  </div>

  <div class="form-actions mt-3">
    <button class="glass-btn primary" type="submit">
      <i class="bi bi-save"></i> {{ button_label|default('Guardar') }}
    </button>
  </div>
{{ form_end(form) }}
