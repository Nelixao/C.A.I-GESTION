{% extends 'base.html.twig' %}

{% block title %}Circular — {{ circular.numCircular }}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Circular</h1>
    <div class="glass-actions">
      <a href="{{ path('app_circular_index') }}" class="glass-btn">
        <i class="bi bi-arrow-left"></i> Listado
      </a>
      <a href="{{ path('app_circular_edit', {'id': circular.id}) }}" class="glass-btn primary">
        <i class="bi bi-pencil"></i> Editar
      </a>
    </div>
  </div>

  <div class="glass-card">
    <div class="row g-3">

      <div class="col-md-4">
        <div class="detail-label">Folio / Núm. Circular</div>
        <div class="detail-value fw-bold">{{ circular.numCircular ?? '—' }}</div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Fecha</div>
        <div class="detail-value">{{ circular.fecha ? circular.fecha|date('d/m/Y') : '—' }}</div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Estado</div>
        <div class="detail-value">
          {% set estadoClass =
            circular.estado == 'ABIERTA'     ? 'bg-success-subtle text-success-emphasis' :
            (circular.estado == 'EN_TRAMITE' ? 'bg-warning-subtle text-warning-emphasis' :
            (circular.estado == 'ARCHIVADA'  ? 'bg-secondary-subtle text-secondary-emphasis' :
            'bg-secondary-subtle text-secondary-emphasis')) %}
          <span class="badge {{ estadoClass }}">{{ circular.estado }}</span>
        </div>
      </div>

      <div class="col-12">
        <div class="detail-label">Título</div>
        <div class="detail-value fw-semibold">{{ circular.titulo ?? '—' }}</div>
      </div>

      <div class="col-12">
        <div class="detail-label">Contenido</div>
        <div class="detail-value">{{ circular.contenido ?? '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Fecha Límite</div>
        <div class="detail-value">{{ circular.fechaLimite ? circular.fechaLimite|date('d/m/Y') : '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Fecha de Cierre</div>
        <div class="detail-value">{{ circular.fechaCierre ? circular.fechaCierre|date('d/m/Y') : '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Responsable</div>
        <div class="detail-value">
          {% if circular.user %}
            {{ circular.user.nombre ?? circular.user.email }}
          {% else %}
            —
          {% endif %}
        </div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Creado</div>
        <div class="detail-value">{{ circular.createdAt ? circular.createdAt|date('d/m/Y H:i') : '—' }}</div>
      </div>

    </div>
  </div>

  <div class="mt-3">
    {{ include('circular/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
