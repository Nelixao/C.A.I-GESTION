<form id="delete-circular-{{ circular.id }}" method="post" action="{{ path('app_circular_delete', {'id': circular.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ circular.id) }}">
</form>
<button type="button" class="btn btn-outline-danger btn-sm"
        data-delete-form="delete-circular-{{ circular.id }}"
        data-confirm-msg="¿Eliminar la circular {{ circular.folio ?? '#' ~ circular.id }}? Esta acción no se puede deshacer."
        title="Eliminar">
    <i class="bi bi-trash"></i> Eliminar
</button>
