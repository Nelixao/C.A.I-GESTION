<form id="delete-oficio-{{ oficio.id }}" method="post" action="{{ path('app_oficio_delete', {'id': oficio.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ oficio.id) }}">
</form>
<button type="button" class="btn btn-outline-danger btn-sm"
        data-delete-form="delete-oficio-{{ oficio.id }}"
        data-confirm-msg="¿Eliminar el oficio {{ oficio.folio ?? '#' ~ oficio.id }}? Esta acción no se puede deshacer."
        title="Eliminar">
    <i class="bi bi-trash"></i> Eliminar
</button>
