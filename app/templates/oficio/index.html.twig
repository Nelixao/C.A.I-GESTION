{% extends 'base.html.twig' %}

{% block title %}Oficios{% endblock %}

{% block stylesheets %}{% endblock %}
{% block body %}
<div class="container-glass">

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Listado de Oficios</h1>

    <div class="glass-actions">
      <a href="{{ path('app_oficio_export') }}" class="glass-btn success">
        <i class="bi bi-download"></i> Exportar a Excel
      </a>
      <a href="{{ path('app_oficio_new') }}" class="glass-btn primary">
        <i class="bi bi-plus-circle"></i> Crear nuevo oficio
      </a>
    </div>
  </div>

  <div class="js-table-wrapper">
    <div class="toolbar js-table-toolbar">
      <input type="text" class="js-search form-input" placeholder="Buscar por folio, asunto, remitente…">
      <select class="js-stage form-select">
        <option value="todos">Todos los estados</option>
        <option value="abierto">Abierto</option>
        <option value="en trámite">En Trámite</option>
        <option value="cerrado">Cerrado</option>
      </select>
    </div>

    <div class="table-responsive">
      <table class="table-glass js-enhanced-table">
        <thead>
          <tr>
            <th>Folio</th>
            <th>Asunto</th>
            <th>Remitente</th>
            <th>Dirigido a</th>
            <th>Recibido por</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
        {% for oficio in oficios %}
          {% set estado = (oficio.status ?? 'abierto')|lower %}
          {% set row_text = (oficio.folio ~ ' ' ~ oficio.asunto ~ ' ' ~ oficio.sender ~ ' ' ~ oficio.recipient ~ ' ' ~ oficio.recibidoPor ~ ' ' ~ oficio.status)|lower %}

          <tr data-stage="{{ estado }}" data-text="{{ row_text }}">
            <td data-label="Folio">
              <strong>{{ oficio.folio ?? ('#' ~ oficio.id) }}</strong>
            </td>
            <td data-label="Asunto">{{ oficio.asunto|default(oficio.title)|default('—') }}</td>
            <td data-label="Remitente">{{ oficio.sender|default('—') }}</td>
            <td data-label="Dirigido a">{{ oficio.recipient|default('—') }}</td>
            <td data-label="Recibido por">{{ oficio.recibidoPor|default('—') }}</td>
            <td data-label="Fecha">{{ oficio.date ? oficio.date|date('d/m/Y') : '—' }}</td>
            <td data-label="Estado">
              <span class="pill-badge {{ estado }}">{{ oficio.status|default('Abierto') }}</span>
            </td>
            <td data-label="Acciones" class="text-center">
              <a href="{{ path('app_oficio_show', {'id': oficio.id}) }}" class="btn btn-outline-primary btn-sm" title="Ver">
                <i class="bi bi-eye"></i>
              </a>
              <a href="{{ path('app_oficio_edit', {'id': oficio.id}) }}" class="btn btn-outline-warning btn-sm" title="Editar">
                <i class="bi bi-pencil-square"></i>
              </a>
              {% if is_granted('ROLE_ADMIN') %}
                <form id="del-oficio-{{ oficio.id }}" method="post" action="{{ path('app_oficio_delete', {'id': oficio.id}) }}" style="display:none">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ oficio.id) }}">
                </form>
                <button type="button" class="btn btn-outline-danger btn-sm" title="Eliminar"
                        data-delete-form="del-oficio-{{ oficio.id }}"
                        data-confirm-msg="¿Eliminar el oficio {{ oficio.folio ?? '#' ~ oficio.id }}?">
                  <i class="bi bi-trash"></i>
                </button>
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="8" class="text-center text-muted py-4">
              <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
              No hay oficios aún. <a href="{{ path('app_oficio_new') }}" class="text-decoration-none">¡Crea el primero!</a>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="js-counter table-counter">&nbsp;</div>
  </div>

  <a href="{{ path('app_oficio_new') }}" class="glass-btn primary float-btn">
    <i class="bi bi-plus-lg"></i> Nuevo oficio
  </a>
</div>
{% endblock %}
