{% extends 'base.html.twig' %}

{% block title %}Oficio — {{ oficio.numOficio ?? '#'~oficio.id }}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">
      Oficio
      {% if oficio.isCisae %}<span class="badge bg-danger ms-2">CISAE</span>{% endif %}
    </h1>
    <div class="glass-actions">
      <a href="{{ path('app_oficio_index') }}" class="glass-btn">
        <i class="bi bi-arrow-left"></i> Listado
      </a>
      <a href="{{ path('app_oficio_edit', {'id': oficio.id}) }}" class="glass-btn primary">
        <i class="bi bi-pencil"></i> Editar
      </a>
    </div>
  </div>

  <div class="glass-card">
    <div class="row g-3">

      <div class="col-md-4">
        <div class="detail-label">Número de Oficio</div>
        <div class="detail-value fw-bold">{{ oficio.numOficio ?? '—' }}</div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Estado</div>
        <div class="detail-value">
          <span class="pill-badge {{ oficio.status|lower|replace({' ': '-', 'é': 'e', 'á': 'a'}) }}">{{ oficio.status }}</span>
        </div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Área</div>
        <div class="detail-value">{{ oficio.area ?? '—' }}</div>
      </div>

      <div class="col-12">
        <div class="detail-label">Asunto</div>
        <div class="detail-value fw-semibold">{{ oficio.title ?? '—' }}</div>
      </div>

      <div class="col-12">
        <div class="detail-label">Contenido</div>
        <div class="detail-value">{{ oficio.content ?? '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Remitente</div>
        <div class="detail-value">{{ oficio.sender ?? '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Destinatario</div>
        <div class="detail-value">{{ oficio.recipient ?? '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Fecha</div>
        <div class="detail-value">{{ oficio.date ? oficio.date|date('d/m/Y') : '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Fecha de Emisión</div>
        <div class="detail-value">{{ oficio.fechaEmision ? oficio.fechaEmision|date('d/m/Y') : '—' }}</div>
      </div>

      {% if oficio.cisae %}
      <div class="col-md-6">
        <div class="detail-label">Expediente CISAE</div>
        <div class="detail-value">
          <a href="{{ path('app_cisae_show', {'id': oficio.cisae.id}) }}" class="text-danger fw-bold">
            <i class="bi bi-exclamation-circle-fill me-1"></i>{{ oficio.cisae.numero }}
          </a>
        </div>
      </div>
      {% endif %}

      {% if oficio.correspondence %}
      <div class="col-md-6">
        <div class="detail-label">Correspondencia Relacionada</div>
        <div class="detail-value">
          <a href="{{ path('app_correspondence_show', {'id': oficio.correspondence.id}) }}">
            {{ oficio.correspondence.numControl }}
          </a>
        </div>
      </div>
      {% endif %}

      {% if oficio.filePath %}
      <div class="col-md-6">
        <div class="detail-label">Archivo adjunto</div>
        <div class="detail-value">
          <a href="{{ asset(oficio.filePath) }}" target="_blank" class="glass-btn">
            <i class="bi bi-file-earmark-arrow-down"></i> Descargar
          </a>
        </div>
      </div>
      {% endif %}

      <div class="col-md-6">
        <div class="detail-label">Registrado</div>
        <div class="detail-value">{{ oficio.createdAt ? oficio.createdAt|date('d/m/Y H:i') : '—' }}</div>
      </div>

    </div>
  </div>

  <div class="mt-3">
    {{ include('oficio/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
