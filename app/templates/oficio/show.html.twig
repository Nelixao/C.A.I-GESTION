{% extends 'base.html.twig' %}

{% block title %}Oficio {{ oficio.folio ?? oficio.id }}{% endblock %}

{% block body %}
<div class="container-glass">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">Oficio {{ oficio.folio ?? ('#' ~ oficio.id) }}</h1>
        <span class="pill-badge {{ (oficio.status ?? 'abierto')|lower }}">{{ oficio.status|default('Abierto') }}</span>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Folio</dt>
                <dd class="col-sm-8"><strong>{{ oficio.folio ?? '—' }}</strong></dd>

                <dt class="col-sm-4">Fecha del documento</dt>
                <dd class="col-sm-8">{{ oficio.date ? oficio.date|date('d/m/Y') : '—' }}</dd>

                <dt class="col-sm-4">Remitente</dt>
                <dd class="col-sm-8">{{ oficio.sender|default('—') }}</dd>

                <dt class="col-sm-4">Dirigido a</dt>
                <dd class="col-sm-8">{{ oficio.recipient|default('—') }}</dd>

                <dt class="col-sm-4">Asunto</dt>
                <dd class="col-sm-8">{{ oficio.asunto|default(oficio.title)|default('—') }}</dd>

                <dt class="col-sm-4">Recibido por</dt>
                <dd class="col-sm-8">{{ oficio.recibidoPor|default('—') }}</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">{{ oficio.status|default('Abierto') }}</dd>

                {% if oficio.filePath %}
                <dt class="col-sm-4">Archivo adjunto</dt>
                <dd class="col-sm-8">
                    <a href="{{ asset(oficio.filePath) }}" target="_blank" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-file-earmark"></i> Ver archivo
                    </a>
                </dd>
                {% endif %}

                <dt class="col-sm-4">Registrado por</dt>
                <dd class="col-sm-8">{{ oficio.user ? (oficio.user.nombre ?? oficio.user.email) : '—' }}</dd>

                <dt class="col-sm-4">Fecha de registro</dt>
                <dd class="col-sm-8">{{ oficio.createdAt ? oficio.createdAt|date('d/m/Y H:i') : '—' }}</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a href="{{ path('app_oficio_index') }}" class="glass-btn" style="border-color:#B28E5C;color:#B28E5C">
          <i class="bi bi-arrow-left"></i> Regresar
        </a>
        <div>
            <a href="{{ path('app_oficio_edit', {'id': oficio.id}) }}" class="glass-btn primary me-2">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
            {{ include('oficio/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
