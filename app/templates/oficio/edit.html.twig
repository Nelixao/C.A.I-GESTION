{% extends 'base.html.twig' %}

{% block title %}Editar Oficio{% endblock %}

{% block body %}
<div class="container-glass">

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Editar Oficio</h1>

    <div class="glass-actions">
      <a href="{{ path('app_oficio_index') }}" class="glass-btn" style="border-color:#B28E5C;color:#B28E5C">
        <i class="bi bi-arrow-left"></i> Regresar
      </a>
      {% if is_granted('ROLE_ADMIN') %}
        <div class="d-inline-block">
          {{ include('oficio/_delete_form.html.twig') }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="glass-card">
    {{ include('oficio/_form.html.twig', {'button_label': 'Guardar cambios'}) }}
  </div>

</div>
{% endblock %}
