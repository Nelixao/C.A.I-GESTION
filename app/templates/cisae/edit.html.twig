{% extends 'base.html.twig' %}
{% block title %}Editar trámite CISAE{% endblock %}
{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Editar Trámite CISAE</h1>
    <div class="glass-actions">
      <a href="{{ path('app_cisae_show', {'id': cisae.id}) }}" class="glass-btn">
        <i class="bi bi-eye"></i> Ver
      </a>
      <a href="{{ path('app_cisae_index') }}" class="glass-btn">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
  </div>
  <div class="glass-card">
    {{ form_start(form, { attr: { class: 'form-glass' } }) }}
      {{ include('cisae/_form.html.twig') }}
      <div class="form-actions mt-3">
        <button class="glass-btn primary" type="submit">
          <i class="bi bi-save"></i> Guardar cambios
        </button>
      </div>
    {{ form_end(form) }}
  </div>
  {% if is_granted('ROLE_ADMIN') %}
    <div class="mt-3">{{ include('cisae/_delete_form.html.twig') }}</div>
  {% endif %}
</div>
{% endblock %}
