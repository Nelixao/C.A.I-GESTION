{% extends 'base.html.twig' %}

{% block title %}CISAE — Editar {{ cisae.numero }}{% endblock %}

{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title"><i class="bi bi-pencil-square text-danger me-2"></i>Editar {{ cisae.numero }}</h1>
    <div class="glass-actions">
      <a href="{{ path('app_cisae_show', {'id': cisae.id}) }}" class="glass-btn">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>
  </div>

  <div class="glass-card">
    {{ include('cisae/_form.html.twig', {'button_label': 'Actualizar'}) }}
  </div>

  <div class="mt-3">
    {{ include('cisae/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
