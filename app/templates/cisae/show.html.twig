{% extends 'base.html.twig' %}
{% block title %}Trámite CISAE #{{ cisae.folio ?? cisae.id }}{% endblock %}
{% block body %}
<div class="container-glass">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title">Trámite CISAE — {{ cisae.folio ?? ('#' ~ cisae.id) }}</h1>
    <div class="glass-actions">
      <a href="{{ path('app_cisae_edit', {'id': cisae.id}) }}" class="glass-btn warning">
        <i class="bi bi-pencil-square"></i> Editar
      </a>
      <a href="{{ path('app_cisae_index') }}" class="glass-btn" style="border-color:#B28E5C;color:#B28E5C">
        <i class="bi bi-arrow-left"></i> Regresar
      </a>
    </div>
  </div>

  {% if diasRestantes is not null %}
    {% if diasRestantes < 0 %}
      <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <strong>Vencido hace {{ diasRestantes * -1 }} día(s)</strong>
      </div>
    {% elseif diasRestantes < 3 %}
      <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-clock-fill fs-5"></i>
        <strong>¡Crítico! Vence en {{ diasRestantes }} día(s)</strong>
      </div>
    {% elseif diasRestantes < 7 %}
      <div class="alert alert-warning d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle fs-5"></i>
        Vence en <strong>{{ diasRestantes }} día(s)</strong>
      </div>
    {% else %}
      <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle fs-5"></i>
        Restan <strong>{{ diasRestantes }} días</strong> para la fecha límite
      </div>
    {% endif %}
  {% endif %}

  <div class="glass-card">
    <table class="table table-borderless">
      <tbody>
        <tr><th style="width:200px">Folio</th><td>{{ cisae.folio ?? '—' }}</td></tr>
        <tr><th>Título</th><td>{{ cisae.titulo }}</td></tr>
        <tr><th>Área / Departamento</th><td>{{ cisae.area }}</td></tr>
        <tr><th>Estado</th><td><span class="pill-badge {{ cisae.status|lower }}">{{ cisae.status }}</span></td></tr>
        <tr><th>Usuario responsable</th>
          <td>{% if cisae.user %}{{ cisae.user.nombre ?? cisae.user.email }}{% else %}—{% endif %}</td>
        </tr>
        <tr><th>Fecha límite</th><td>{{ cisae.fechaLimite ? cisae.fechaLimite|date('d/m/Y') : '—' }}</td></tr>
        <tr><th>Descripción</th><td>{{ cisae.descripcion|default('—')|nl2br }}</td></tr>
        <tr><th>Creado el</th><td>{{ cisae.createdAt ? cisae.createdAt|date('d/m/Y H:i') : '—' }}</td></tr>
        <tr><th>Actualizado el</th><td>{{ cisae.updatedAt ? cisae.updatedAt|date('d/m/Y H:i') : '—' }}</td></tr>
      </tbody>
    </table>
  </div>

  {% if is_granted('ROLE_ADMIN') %}
    <div class="mt-3">{{ include('cisae/_delete_form.html.twig') }}</div>
  {% endif %}
</div>
{% endblock %}
