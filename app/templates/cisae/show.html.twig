{% extends 'base.html.twig' %}

{% block title %}CISAE — {{ cisae.numero }}{% endblock %}

{% block body %}
<div class="container-glass">

  <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h1 class="page-title"><i class="bi bi-exclamation-circle-fill text-danger me-2"></i>{{ cisae.numero }}</h1>
    <div class="glass-actions">
      <a href="{{ path('app_cisae_index') }}" class="glass-btn">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
      {% if is_granted('ROLE_ADMIN') %}
      <a href="{{ path('app_cisae_edit', {'id': cisae.id}) }}" class="glass-btn primary">
        <i class="bi bi-pencil"></i> Editar
      </a>
      {% endif %}
    </div>
  </div>

  {# ── Datos del expediente ──────────────────────────── #}
  <div class="glass-card mb-4">
    <div class="row g-3">

      <div class="col-md-4">
        <div class="detail-label">Número de Expediente</div>
        <div class="detail-value fw-bold">{{ cisae.numero }}</div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Estado</div>
        <div class="detail-value">
          {% set badgeClass =
            cisae.estado == 'ABIERTO'     ? 'bg-success-subtle text-success-emphasis' :
            (cisae.estado == 'EN_TRAMITE' ? 'bg-warning-subtle text-warning-emphasis' :
            'bg-secondary-subtle text-secondary-emphasis') %}
          <span class="badge {{ badgeClass }}">{{ cisae.estado|replace({'_': ' '}) }}</span>
        </div>
      </div>

      <div class="col-md-4">
        <div class="detail-label">Área</div>
        <div class="detail-value">{{ cisae.area ?? '—' }}</div>
      </div>

      <div class="col-12">
        <div class="detail-label">Título</div>
        <div class="detail-value">{{ cisae.titulo }}</div>
      </div>

      <div class="col-12">
        <div class="detail-label">Descripción</div>
        <div class="detail-value">{{ cisae.descripcion ?? '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Fecha de Inicio</div>
        <div class="detail-value">{{ cisae.fechaInicio ? cisae.fechaInicio|date('d/m/Y') : '—' }}</div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Fecha de Término</div>
        <div class="detail-value">
          {% if cisae.fechaTermino %}
            {% set diff = (cisae.fechaTermino.timestamp - date().timestamp) / 86400 %}
            <span class="{{ diff < 0 and cisae.estado != 'CERRADO' ? 'text-danger fw-bold' : '' }}">
              {{ cisae.fechaTermino|date('d/m/Y') }}
            </span>
            {% if cisae.estado != 'CERRADO' %}
              {% if diff < 0 %}
                <span class="badge bg-danger ms-1">Vencido</span>
              {% elseif diff <= 3 %}
                <span class="badge bg-warning text-dark ms-1">{{ diff|round(0,'ceil') }} días</span>
              {% endif %}
            {% endif %}
          {% else %}—{% endif %}
        </div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Responsable</div>
        <div class="detail-value">
          {{ cisae.user ? (cisae.user.nombre ?? cisae.user.email) : '—' }}
        </div>
      </div>

      <div class="col-md-6">
        <div class="detail-label">Creado</div>
        <div class="detail-value">{{ cisae.createdAt ? cisae.createdAt|date('d/m/Y H:i') : '—' }}</div>
      </div>

      {% if cisae.observaciones %}
      <div class="col-12">
        <div class="detail-label">Observaciones</div>
        <div class="detail-value">{{ cisae.observaciones }}</div>
      </div>
      {% endif %}

    </div>
  </div>

  {# ── Oficios asociados ─────────────────────────────── #}
  <div class="glass-card">
    <h5 class="mb-3"><i class="bi bi-file-earmark-text me-2"></i>Oficios asociados</h5>
    {% if oficios|length > 0 %}
    <div class="table-responsive">
      <table class="table-glass">
        <thead>
          <tr>
            <th>Núm. Oficio</th>
            <th>Asunto</th>
            <th>Remitente</th>
            <th>Fecha Emisión</th>
            <th>Estado</th>
            <th class="text-center">Ver</th>
          </tr>
        </thead>
        <tbody>
        {% for o in oficios %}
          <tr>
            <td class="fw-bold">{{ o.numOficio ?? '#'~o.id }}</td>
            <td>{{ o.title|slice(0, 60) }}{{ o.title|length > 60 ? '…' : '' }}</td>
            <td>{{ o.sender ?? '—' }}</td>
            <td>{{ o.fechaEmision ? o.fechaEmision|date('d/m/Y') : '—' }}</td>
            <td><span class="pill-badge {{ o.status|lower|replace({' ': '-', 'é': 'e', 'á': 'a'}) }}">{{ o.status }}</span></td>
            <td class="text-center">
              <a href="{{ path('app_oficio_show', {'id': o.id}) }}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-eye"></i>
              </a>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
      <p class="text-muted">No hay oficios vinculados a este expediente.</p>
      <a href="{{ path('app_oficio_new') }}" class="glass-btn primary">
        <i class="bi bi-plus-circle"></i> Crear oficio vinculado
      </a>
    {% endif %}
  </div>

  {% if is_granted('ROLE_ADMIN') %}
  <div class="mt-3">
    {{ include('cisae/_delete_form.html.twig') }}
  </div>
  {% endif %}

</div>
{% endblock %}
