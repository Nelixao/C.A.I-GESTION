<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{% block title %}C.A.I. Gestión{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#9b2247">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Text:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset('css/style.css') }}">

  {% block stylesheets %}{% endblock %}
</head>
<body>

{% set route = app.request.attributes.get('_route') %}
{% set user  = app.user %}

<!-- Sidebar overlay (mobile) -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="shell">

  <!-- ── Sidebar ────────────────────────────────────────── -->
  <aside class="sidebar" id="sidebar">

    <div class="sidebar-brand">
      <div class="sidebar-logo">C</div>
      <div class="sidebar-brand-text">
        <strong>C.A.I.</strong>
        <small>Sistema Administrativo</small>
      </div>
    </div>

    <nav class="sidebar-nav">

      <span class="nav-section-label">Principal</span>
      <a href="{{ path('app_home') }}"
         class="nav-link {% if route starts with 'app_home' %}active{% endif %}">
        <i class="bi bi-house"></i> Inicio
      </a>
      <a href="{{ path('app_dashboard') }}"
         class="nav-link verde {% if route starts with 'app_dashboard' %}active{% endif %}">
        <i class="bi bi-speedometer2"></i> Dashboard
      </a>

      <a href="{{ path('app_calendario_index') }}"
         class="nav-link dorado {% if route starts with 'app_calendario' %}active{% endif %}">
        <i class="bi bi-calendar3"></i> Calendario
      </a>

      <span class="nav-section-label">Documentos</span>
      <a href="{{ path('app_oficio_index') }}"
         class="nav-link {% if route starts with 'app_oficio' %}active{% endif %}">
        <i class="bi bi-file-earmark-text"></i> Oficios
      </a>
      <a href="{{ path('app_correspondence_index') }}"
         class="nav-link {% if route starts with 'app_correspondence' %}active{% endif %}">
        <i class="bi bi-envelope"></i> Correspondencia
      </a>
      <a href="{{ path('app_circular_index') }}"
         class="nav-link {% if route starts with 'app_circular' %}active{% endif %}">
        <i class="bi bi-arrow-repeat"></i> Circulares
      </a>
      <a href="{{ path('app_scanner_index') }}"
         class="nav-link verde {% if route starts with 'app_scanner' %}active{% endif %}">
        <i class="bi bi-upc-scan"></i> Digitalización
      </a>

      <span class="nav-section-label" style="color:rgba(220,53,69,.9);">CISAE</span>
      <a href="{{ path('app_cisae_index') }}"
         class="nav-link {% if route starts with 'app_cisae' %}active{% endif %}"
         style="--nav-accent:#dc3545;">
        <i class="bi bi-exclamation-circle-fill" style="color:#dc3545"></i> Expedientes CISAE
      </a>

      {% if is_granted('ROLE_ADMIN') %}
      <span class="nav-section-label">Administración</span>
      <a href="{{ path('app_user_index') }}"
         class="nav-link dorado {% if route starts with 'app_user' %}active{% endif %}">
        <i class="bi bi-people"></i> Usuarios
      </a>
      <a href="{{ path('app_role_index') }}"
         class="nav-link dorado {% if route starts with 'app_role' %}active{% endif %}">
        <i class="bi bi-shield-lock"></i> Roles
      </a>
      {% endif %}

    </nav>

    <div class="sidebar-footer">
      {% if user %}
        <div class="sidebar-user">
          <div class="user-avatar">{{ user.nombre ? user.nombre|first|upper : user.email|first|upper }}</div>
          <div class="user-info">
            <span class="user-name">{{ user.nombre ?? user.email }}</span>
            <span class="user-role">{{ user.rol ?? 'Usuario' }}</span>
          </div>
        </div>
        <a href="{{ path('app_logout') }}" class="nav-link" style="margin-top:0.4rem; color: rgba(255,255,255,0.45);">
          <i class="bi bi-box-arrow-left"></i> Cerrar sesión
        </a>
      {% endif %}
    </div>

  </aside>

  <!-- ── Main ───────────────────────────────────────────── -->
  <div class="main">

    <header class="topbar">
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="Menú">
        <i class="bi bi-list"></i>
      </button>
      <span class="module-title">{% block module_title %}{% block title_short %}{{ block('title') }}{% endblock %}{% endblock %}</span>
      <div class="spacer"></div>
      {% if user %}
        <a href="{{ path('app_dashboard') }}" class="topbar-icon-btn" title="Dashboard">
          <i class="bi bi-speedometer2"></i>
        </a>
        <a href="{{ path('app_logout') }}" class="topbar-icon-btn" title="Cerrar sesión">
          <i class="bi bi-box-arrow-right"></i>
        </a>
      {% endif %}
    </header>

    <main class="content">
      {% block body %}{% endblock %}
    </main>

    <footer>
      &copy; {{ "now"|date("Y") }} C.A.I. — Sistema de Gestión Documental &nbsp;·&nbsp; Todos los derechos reservados
    </footer>

  </div><!-- /main -->

</div><!-- /shell -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('js/javascrip.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
