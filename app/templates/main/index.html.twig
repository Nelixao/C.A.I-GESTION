{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const palette = ['#9D2148','#B28E5C','#1e5b4f','#6c3483','#2471a3','#c0392b','#148f77','#8e6e3e'];
  const _statuses = {{ statusDistribution|json_encode|raw }};
  const labels = Object.keys(_statuses);
  const values = Object.values(_statuses);
  const hasData = values.some(v => v > 0);

  const ctx = document.getElementById('donutChart');
  if (ctx && hasData) {
    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{
          data: values,
          backgroundColor: palette.slice(0, labels.length),
          borderWidth: 0,
          hoverOffset: 8,
        }]
      },
      options: {
        cutout: '68%',
        plugins: { legend: { display: false } },
        animation: { animateScale: true }
      }
    });

    // Leyenda manual con etiquetas grandes
    const legend = document.getElementById('statusLegend');
    labels.forEach((lbl, i) => {
      const total = values.reduce((a, b) => a + b, 0);
      const pct   = total > 0 ? Math.round(values[i] / total * 100) : 0;
      legend.innerHTML += `
        <div style="display:flex;align-items:center;gap:.5rem;
                    background:rgba(0,0,0,.04);border-radius:10px;
                    padding:.45rem .9rem;font-family:'Roboto',sans-serif;">
          <span style="width:14px;height:14px;border-radius:4px;
                       background:${palette[i]};flex-shrink:0;display:inline-block;"></span>
          <span style="font-size:.92rem;font-weight:500;">${lbl}</span>
          <span style="font-family:'Cabin',sans-serif;font-weight:700;
                       font-size:1rem;color:${palette[i]};">${values[i]}</span>
          <span style="font-size:.78rem;color:#888;">(${pct}%)</span>
        </div>`;
    });
  } else if (ctx) {
    ctx.closest('.row').innerHTML =
      '<div class="col-12 text-center text-muted py-4" style="font-family:Roboto,sans-serif">' +
      '<i class="bi bi-bar-chart-fill fs-2 mb-2 d-block opacity-25"></i>Sin registros aún</div>';
  }
});
</script>
{% endblock %}
