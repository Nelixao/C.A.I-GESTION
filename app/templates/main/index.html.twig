{% extends 'base.html.twig' %}

{% block title %}Inicio — C.A.I-GESTION{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Variables institucionales ─────────────────────────────── */
:root {
  --guinda:     #9D2148;
  --guinda-dk:  #7a1938;
  --guinda-lt:  rgba(157,33,72,.10);
  --dorado:     #B28E5C;
  --dorado-dk:  #8e6e3e;
  --dorado-lt:  rgba(178,142,92,.12);
}

/* ── Hero banner ───────────────────────────────────────────── */
.home-hero {
  background: linear-gradient(135deg, var(--guinda) 0%, #6b1030 55%, var(--dorado-dk) 100%);
  padding: 2.5rem 2rem 2rem;
  border-radius: 20px;
  margin-bottom: 2rem;
  position: relative;
  overflow: hidden;
  color: #fff;
}
.home-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M50 50c0-5.523 4.477-10 10-10s10 4.477 10 10-4.477 10-10 10c0 5.523-4.477 10-10 10s-10-4.477-10-10 4.477-10 10-10zM10 10c0-5.523 4.477-10 10-10s10 4.477 10 10-4.477 10-10 10c0 5.523-4.477 10-10 10S0 25.523 0 20s4.477-10 10-10z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.hero-logo {
  width: 64px;
  height: 64px;
  background: rgba(255,255,255,.15);
  border: 2px solid rgba(255,255,255,.35);
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  flex-shrink: 0;
}
.hero-title {
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  letter-spacing: -.01em;
  margin: 0;
  line-height: 1.15;
}
.hero-subtitle {
  font-family: 'Roboto', sans-serif;
  font-size: 1rem;
  opacity: .85;
  margin: .35rem 0 0;
}
.hero-welcome {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  background: rgba(255,255,255,.15);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 30px;
  padding: .45rem 1.1rem;
  font-family: 'Roboto', sans-serif;
  font-size: .95rem;
  margin-top: 1.2rem;
}
.hero-badge {
  display: inline-block;
  background: var(--dorado);
  color: #fff;
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-size: .7rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  border-radius: 6px;
  padding: .2rem .55rem;
}

/* ── Module cards grid ─────────────────────────────────────── */
.modules-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
  margin-bottom: 1.75rem;
}
.mod-card {
  background: #fff;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 18px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: .85rem;
  transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  box-shadow: 0 2px 12px rgba(0,0,0,.06);
  position: relative;
  overflow: hidden;
}
.mod-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  border-radius: 18px 18px 0 0;
}
.mod-card.accent-guinda::after { background: var(--guinda); }
.mod-card.accent-dorado::after { background: var(--dorado); }

.mod-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 40px rgba(0,0,0,.12);
}
.mod-card.accent-guinda:hover { border-color: rgba(157,33,72,.25); }
.mod-card.accent-dorado:hover  { border-color: rgba(178,142,92,.3); }

.mod-icon {
  width: 62px;
  height: 62px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.9rem;
  flex-shrink: 0;
}
.mod-icon.guinda { background: var(--guinda-lt); color: var(--guinda); }
.mod-icon.dorado  { background: var(--dorado-lt); color: var(--dorado-dk); }

.mod-top { display: flex; align-items: center; gap: 1rem; }
.mod-name {
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-size: 1.15rem;
  color: #1a1a2e;
  margin: 0;
}
.mod-count {
  font-family: 'Cabin', sans-serif;
  font-size: 2.4rem;
  font-weight: 800;
  line-height: 1;
  margin: 0;
}
.mod-card.accent-guinda .mod-count { color: var(--guinda); }
.mod-card.accent-dorado  .mod-count { color: var(--dorado-dk); }

.mod-label {
  font-family: 'Roboto', sans-serif;
  font-size: .82rem;
  color: #6c757d;
  margin: -.4rem 0 0;
}
.mod-btn {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  font-family: 'Cabin', sans-serif;
  font-weight: 600;
  font-size: .88rem;
  padding: .5rem 1.1rem;
  border-radius: 10px;
  text-decoration: none;
  border: 2px solid transparent;
  transition: background .18s, color .18s, border-color .18s;
  align-self: flex-start;
}
.mod-card.accent-guinda .mod-btn {
  color: var(--guinda);
  border-color: rgba(157,33,72,.3);
  background: var(--guinda-lt);
}
.mod-card.accent-guinda .mod-btn:hover {
  background: var(--guinda);
  color: #fff;
  border-color: var(--guinda);
}
.mod-card.accent-dorado .mod-btn {
  color: var(--dorado-dk);
  border-color: rgba(178,142,92,.35);
  background: var(--dorado-lt);
}
.mod-card.accent-dorado .mod-btn:hover {
  background: var(--dorado);
  color: #fff;
  border-color: var(--dorado);
}

/* Dark mode adjustments */
[data-theme="dark"] .mod-card {
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.09);
}
[data-theme="dark"] .mod-name { color: #f0f0f0; }

/* ── Acceso rápido ─────────────────────────────────────────── */
.quick-bar {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
  background: #fff;
  border: 1px solid rgba(0,0,0,.07);
  border-radius: 16px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1.75rem;
  box-shadow: 0 2px 12px rgba(0,0,0,.05);
}
[data-theme="dark"] .quick-bar {
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.08);
}
.quick-bar-label {
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-size: .8rem;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: #888;
  display: flex;
  align-items: center;
  margin-right: .5rem;
  flex-shrink: 0;
}
.qbtn {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  font-family: 'Cabin', sans-serif;
  font-weight: 600;
  font-size: .92rem;
  padding: .55rem 1.15rem;
  border-radius: 10px;
  text-decoration: none;
  border: none;
  transition: transform .18s, box-shadow .18s;
}
.qbtn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.15); }
.qbtn-guinda { background: var(--guinda); color: #fff; }
.qbtn-dorado  { background: var(--dorado); color: #fff; }
.qbtn-guinda-out {
  background: transparent;
  color: var(--guinda);
  border: 2px solid var(--guinda);
}
.qbtn-guinda-out:hover { background: var(--guinda); color: #fff; }

/* ── Guía de Uso ───────────────────────────────────────────── */
.guia-section {
  margin-bottom: 1.75rem;
}
.guia-steps {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1rem;
}
.step-card {
  background: #fff;
  border: 1px solid rgba(0,0,0,.07);
  border-radius: 18px;
  padding: 1.4rem 1.25rem 1.25rem;
  box-shadow: 0 2px 10px rgba(0,0,0,.05);
  display: flex;
  flex-direction: column;
  gap: .75rem;
  transition: box-shadow .2s, transform .2s;
}
.step-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0,0,0,.1);
}
[data-theme="dark"] .step-card {
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.09);
}
.step-number {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: var(--guinda);
  color: #fff;
  font-family: 'Cabin', sans-serif;
  font-weight: 800;
  font-size: 1.05rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step-icon {
  font-size: 1.7rem;
  color: var(--dorado);
}
.step-name {
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-size: 1rem;
  color: #1a1a2e;
  margin: 0;
}
[data-theme="dark"] .step-name { color: #f0f0f0; }
.step-desc {
  font-family: 'Roboto', sans-serif;
  font-size: .87rem;
  color: #55585A;
  margin: 0;
  line-height: 1.5;
}
[data-theme="dark"] .step-desc { color: rgba(240,240,240,.75); }

/* ── Marco Normativo ───────────────────────────────────────── */
.marco-section {
  margin-bottom: 1.75rem;
}
.marco-card {
  background: #fff;
  border-left: 4px solid var(--guinda);
  border-radius: 0 16px 16px 0;
  border-top: 1px solid rgba(0,0,0,.07);
  border-right: 1px solid rgba(0,0,0,.07);
  border-bottom: 1px solid rgba(0,0,0,.07);
  padding: 1.4rem 1.5rem;
  box-shadow: 0 2px 12px rgba(0,0,0,.05);
}
[data-theme="dark"] .marco-card {
  background: rgba(255,255,255,.05);
  border-top-color: rgba(255,255,255,.09);
  border-right-color: rgba(255,255,255,.09);
  border-bottom-color: rgba(255,255,255,.09);
}
.marco-title {
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--guinda);
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: .6rem;
}
.marco-accordion .accordion-item {
  border: none;
  border-bottom: 1px solid rgba(0,0,0,.06);
}
[data-theme="dark"] .marco-accordion .accordion-item {
  border-bottom-color: rgba(255,255,255,.07);
}
.marco-accordion .accordion-item:last-child { border-bottom: none; }
.marco-accordion .accordion-button {
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-size: .95rem;
  color: var(--guinda);
  background: transparent;
  padding: .75rem 0;
  box-shadow: none;
}
.marco-accordion .accordion-button:not(.collapsed) {
  color: var(--guinda);
  background: transparent;
  box-shadow: none;
}
.marco-accordion .accordion-button::after {
  filter: none;
}
[data-theme="dark"] .marco-accordion .accordion-button { color: #f0aabd; }
.marco-accordion .accordion-body {
  padding: .5rem 0 1rem;
}
.marco-accordion .accordion-collapse {
  background: transparent;
}
.ley-item {
  display: flex;
  align-items: flex-start;
  gap: .65rem;
  padding: .4rem 0;
  font-family: 'Roboto', sans-serif;
  font-size: .88rem;
  color: #55585A;
  border-bottom: 1px solid rgba(0,0,0,.04);
}
[data-theme="dark"] .ley-item { color: rgba(240,240,240,.75); border-bottom-color: rgba(255,255,255,.05); }
.ley-item:last-child { border-bottom: none; }
.ley-item .bi {
  color: var(--dorado);
  font-size: .95rem;
  margin-top: .1rem;
  flex-shrink: 0;
}

/* ── Charts section ────────────────────────────────────────── */
.charts-section {
  background: #fff;
  border: 1px solid rgba(0,0,0,.07);
  border-radius: 18px;
  padding: 1.5rem;
  box-shadow: 0 2px 12px rgba(0,0,0,.05);
}
[data-theme="dark"] .charts-section {
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.08);
}
.section-heading {
  font-family: 'Cabin', sans-serif;
  font-weight: 700;
  font-size: 1rem;
  color: var(--guinda);
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: .5rem;
}
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-0">

  {# ── Hero ──────────────────────────────────────────────────── #}
  <div class="home-hero">
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <div class="hero-logo">
        <i class="bi bi-building-fill-gear"></i>
      </div>
      <div>
        <p class="hero-title">C.A.I-GESTION</p>
        <p class="hero-subtitle">Sistema de Gestión Documental &nbsp;·&nbsp; Alcaldía</p>
      </div>
      <div class="ms-auto">
        <span class="hero-badge">Sistema activo</span>
      </div>
    </div>

    {% if app.user %}
    <div class="hero-welcome">
      <i class="bi bi-person-circle"></i>
      Bienvenido/a, <strong>{{ app.user.nombre ?? app.user.userIdentifier }}</strong>
    </div>
    {% endif %}
  </div>

  {# ── Tarjetas de módulos ────────────────────────────────────── #}
  <div class="modules-grid">

    <div class="mod-card accent-guinda">
      <div class="mod-top">
        <div class="mod-icon guinda"><i class="bi bi-file-earmark-text"></i></div>
        <div>
          <p class="mod-name">Oficios</p>
        </div>
      </div>
      <div>
        <p class="mod-count">{{ oficiosCount }}</p>
        <p class="mod-label">registros en el sistema</p>
      </div>
      <a href="{{ path('app_oficio_index') }}" class="mod-btn">
        <i class="bi bi-arrow-right-circle"></i> Ver todos
      </a>
    </div>

    <div class="mod-card accent-dorado">
      <div class="mod-top">
        <div class="mod-icon dorado"><i class="bi bi-inbox"></i></div>
        <div>
          <p class="mod-name">Correspondencia</p>
        </div>
      </div>
      <div>
        <p class="mod-count">{{ correspondencesCount }}</p>
        <p class="mod-label">registros en el sistema</p>
      </div>
      <a href="{{ path('app_correspondence_index') }}" class="mod-btn">
        <i class="bi bi-arrow-right-circle"></i> Ver todos
      </a>
    </div>

    <div class="mod-card accent-guinda">
      <div class="mod-top">
        <div class="mod-icon guinda"><i class="bi bi-megaphone"></i></div>
        <div>
          <p class="mod-name">Circulares</p>
        </div>
      </div>
      <div>
        <p class="mod-count">{{ circularesCount }}</p>
        <p class="mod-label">registros en el sistema</p>
      </div>
      <a href="{{ path('app_circular_index') }}" class="mod-btn">
        <i class="bi bi-arrow-right-circle"></i> Ver todos
      </a>
    </div>

    <div class="mod-card accent-dorado">
      <div class="mod-top">
        <div class="mod-icon dorado"><i class="bi bi-sticky"></i></div>
        <div>
          <p class="mod-name">Notas Informativas</p>
        </div>
      </div>
      <div>
        <p class="mod-count">{{ notasCount }}</p>
        <p class="mod-label">registros en el sistema</p>
      </div>
      <a href="{{ path('app_nota_informativa_index') }}" class="mod-btn">
        <i class="bi bi-arrow-right-circle"></i> Ver todos
      </a>
    </div>

    <div class="mod-card accent-guinda">
      <div class="mod-top">
        <div class="mod-icon guinda"><i class="bi bi-building"></i></div>
        <div>
          <p class="mod-name">CISAE</p>
        </div>
      </div>
      <div>
        <p class="mod-count">{{ cisaeCount }}</p>
        <p class="mod-label">registros en el sistema</p>
      </div>
      <a href="{{ path('app_cisae_index') }}" class="mod-btn">
        <i class="bi bi-arrow-right-circle"></i> Ver todos
      </a>
    </div>

    <div class="mod-card accent-dorado">
      <div class="mod-top">
        <div class="mod-icon dorado"><i class="bi bi-printer"></i></div>
        <div>
          <p class="mod-name">Escáner</p>
        </div>
      </div>
      <div>
        <p class="mod-count">{{ scansCount }}</p>
        <p class="mod-label">registros en el sistema</p>
      </div>
      <a href="{{ path('app_scanner_index') }}" class="mod-btn">
        <i class="bi bi-arrow-right-circle"></i> Ver todos
      </a>
    </div>

  </div>

  {# ── Acceso rápido ──────────────────────────────────────────── #}
  <div class="quick-bar">
    <span class="quick-bar-label"><i class="bi bi-lightning-charge me-1"></i> Crear nuevo</span>
    <a href="{{ path('app_oficio_new') }}" class="qbtn qbtn-guinda">
      <i class="bi bi-file-earmark-plus"></i> Oficio
    </a>
    <a href="{{ path('app_circular_new') }}" class="qbtn qbtn-guinda">
      <i class="bi bi-megaphone"></i> Circular
    </a>
    <a href="{{ path('app_correspondence_new') }}" class="qbtn qbtn-dorado">
      <i class="bi bi-envelope-plus"></i> Correspondencia
    </a>
    <a href="{{ path('app_cisae_new') }}" class="qbtn qbtn-dorado">
      <i class="bi bi-building-add"></i> CISAE
    </a>
    <a href="{{ path('app_dashboard') }}" class="qbtn qbtn-guinda-out ms-auto">
      <i class="bi bi-speedometer2"></i> Dashboard completo
    </a>
  </div>

  {# ── Guía de Uso ───────────────────────────────────────────── #}
  <div class="guia-section">
    <p class="section-heading" style="font-family:'Cabin',sans-serif;font-weight:700;font-size:1rem;color:var(--guinda);margin-bottom:1rem;display:flex;align-items:center;gap:.5rem;">
      <i class="bi bi-map"></i> Guía de Uso
    </p>
    <div class="guia-steps">

      <div class="step-card">
        <div class="d-flex align-items-center gap-3">
          <div class="step-number">1</div>
          <i class="bi bi-pencil-square step-icon"></i>
        </div>
        <p class="step-name">Registro</p>
        <p class="step-desc">Crea un nuevo documento (Oficio, Circular, Correspondencia, etc.) capturando folio, fecha, remitente, asunto y demás datos del registro físico.</p>
      </div>

      <div class="step-card">
        <div class="d-flex align-items-center gap-3">
          <div class="step-number">2</div>
          <i class="bi bi-clipboard2-check step-icon"></i>
        </div>
        <p class="step-name">Seguimiento</p>
        <p class="step-desc">Actualiza el estado del documento conforme avanza su trámite: Pendiente → En Trámite → Concluido/Cerrado. Consulta desde el Dashboard el resumen en tiempo real.</p>
      </div>

      <div class="step-card">
        <div class="d-flex align-items-center gap-3">
          <div class="step-number">3</div>
          <i class="bi bi-printer step-icon"></i>
        </div>
        <p class="step-name">Digitalización</p>
        <p class="step-desc">Escanea o adjunta el documento físico desde el módulo Escáner. El archivo PDF queda vinculado al registro para consulta y respaldo digital.</p>
      </div>

      <div class="step-card">
        <div class="d-flex align-items-center gap-3">
          <div class="step-number">4</div>
          <i class="bi bi-archive step-icon"></i>
        </div>
        <p class="step-name">Archivo</p>
        <p class="step-desc">Una vez concluido el trámite, cambia el estado a Archivado. El expediente queda disponible para consulta histórica y generación de Informes.</p>
      </div>

    </div>
  </div>

  {# ── Marco Normativo ────────────────────────────────────────── #}
  <div class="marco-section">
    <div class="marco-card">
      <p class="marco-title">
        <i class="bi bi-journal-bookmark-fill"></i> Marco Normativo
      </p>

      <div class="accordion marco-accordion" id="accordionMarco">

        <div class="accordion-item">
          <h2 class="accordion-header" id="mh1">
            <button class="accordion-button" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mc1"
                    aria-expanded="true" aria-controls="mc1">
              Códigos y Ética
            </button>
          </h2>
          <div id="mc1" class="accordion-collapse collapse show" aria-labelledby="mh1" data-bs-parent="#accordionMarco">
            <div class="accordion-body">
              <div class="ley-item"><i class="bi bi-file-earmark-text"></i>CÓDIGO DE CONDUCTA DE LA ALCALDÍA IZTACALCO — GACETA OFICIAL NO. 1648-11-JULIO-2025</div>
              <div class="ley-item"><i class="bi bi-file-earmark-text"></i>CÓDIGO DE ÉTICA DE LA ADMINISTRACIÓN PÚBLICA Y ALCALDÍAS DE LA CIUDAD DE MÉXICO</div>
              <div class="ley-item"><i class="bi bi-file-earmark-text"></i>CÓDIGO DE ÉTICA</div>
            </div>
          </div>
        </div>

        <div class="accordion-item">
          <h2 class="accordion-header" id="mh2">
            <button class="accordion-button collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mc2"
                    aria-expanded="false" aria-controls="mc2">
              Leyes y Normatividad
            </button>
          </h2>
          <div id="mc2" class="accordion-collapse collapse" aria-labelledby="mh2" data-bs-parent="#accordionMarco">
            <div class="accordion-body">
              <div class="ley-item"><i class="bi bi-file-earmark-text"></i>CIRCULAR UNO BIS 2015, NORMATIVIDAD EN MATERIA DE ADMINISTRACIÓN DE RECURSOS</div>
