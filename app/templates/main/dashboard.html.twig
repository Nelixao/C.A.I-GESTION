{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    /* ── KPI Grid ──────────────────────────────────────────────── */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.75rem;
    }

    .kpi-card {
      border-radius: 16px;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      border: none;
      backdrop-filter: blur(12px);
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .kpi-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,.18); }

    .kpi-card.c-vino   { background: linear-gradient(135deg,#9b2247 0%,#c0395e 100%); color:#fff; }
    .kpi-card.c-verde  { background: linear-gradient(135deg,#1e5b4f 0%,#2e8b6e 100%); color:#fff; }
    .kpi-card.c-oro    { background: linear-gradient(135deg,#a57f2c 0%,#d4a843 100%); color:#fff; }
    .kpi-card.c-purple { background: linear-gradient(135deg,#6c3483 0%,#9b59b6 100%); color:#fff; }
    .kpi-card.c-azul   { background: linear-gradient(135deg,#2471a3 0%,#3498db 100%); color:#fff; }

    .kpi-icon { font-size: 2.2rem; opacity: .9; }
    .kpi-body { flex: 1; min-width: 0; }
    .kpi-value { font-size: 2.4rem; font-weight: 800; line-height: 1; }
    .kpi-label { font-size: .85rem; opacity: .88; margin-top: .2rem; }
    .kpi-trend { font-size: .78rem; opacity: .8; margin-top: .35rem; }

    /* ── Charts ───────────────────────────────────────────────── */
    .dash-card {
      background: var(--bg-card, rgba(255,255,255,.08));
      border: 1px solid var(--border-color, rgba(255,255,255,.12));
      border-radius: 16px;
      padding: 1.25rem;
      box-shadow: var(--glass-shadow, 0 4px 24px rgba(0,0,0,.12));
      backdrop-filter: blur(12px);
      margin-bottom: 1.25rem;
    }
    .dash-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      gap: .5rem;
    }
    .dash-card-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary, inherit);
      display: flex;
      align-items: center;
      gap: .5rem;
    }
    .chart-box { position: relative; height: 280px; }

    /* ── Tablas ────────────────────────────────────────────────── */
    .dash-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .dash-table th { padding: .5rem .75rem; font-weight: 700; border-bottom: 2px solid var(--border-color,rgba(0,0,0,.1)); }
    .dash-table td { padding: .5rem .75rem; border-bottom: 1px solid var(--border-color,rgba(0,0,0,.06)); }
    .dash-table tr:last-child td { border-bottom: none; }

    /* Acciones rápidas */
    .quick-actions { display: flex; gap: .75rem; flex-wrap: wrap; }

    @media (max-width: 768px) {
      .kpi-grid { grid-template-columns: repeat(2,1fr); }
      .kpi-value { font-size: 1.9rem; }
    }
  </style>
{% endblock %}

{% block body %}
<div class="container-glass" style="max-width:1400px">

  {# ── KPI Cards ───────────────────────────────────────────────── #}
  <div class="kpi-grid">

    <div class="kpi-card c-vino">
      <i class="bi bi-file-earmark-text kpi-icon"></i>
      <div class="kpi-body">
        <div class="kpi-value">{{ oficiosCount|default(0) }}</div>
        <div class="kpi-label">Oficios</div>
        <div class="kpi-trend">
          {% set t = oficiosTrend|default(0) %}
          {% if t > 0 %}+{{ t }}%{% elseif t < 0 %}{{ t }}%{% else %}sin cambio{% endif %} vs mes ant.
        </div>
      </div>
    </div>

    <div class="kpi-card c-verde">
      <i class="bi bi-inbox kpi-icon"></i>
      <div class="kpi-body">
        <div class="kpi-value">{{ correspondencesCount|default(0) }}</div>
        <div class="kpi-label">Correspondencia</div>
        <div class="kpi-trend">
          {% set t = correspondencesTrend|default(0) %}
          {% if t > 0 %}+{{ t }}%{% elseif t < 0 %}{{ t }}%{% else %}sin cambio{% endif %} vs mes ant.
        </div>
      </div>
    </div>

    <div class="kpi-card c-oro">
      <i class="bi bi-megaphone kpi-icon"></i>
      <div class="kpi-body">
        <div class="kpi-value">{{ circularesCount|default(0) }}</div>
        <div class="kpi-label">Circulares</div>
        <div class="kpi-trend">
          {% set t = circularesTrend|default(0) %}
          {% if t > 0 %}+{{ t }}%{% elseif t < 0 %}{{ t }}%{% else %}sin cambio{% endif %} vs mes ant.
        </div>
      </div>
    </div>

    <div class="kpi-card c-purple">
      <i class="bi bi-sticky kpi-icon"></i>
      <div class="kpi-body">
        <div class="kpi-value">{{ notasCount|default(0) }}</div>
        <div class="kpi-label">Notas Informativas</div>
        <div class="kpi-trend">
          {% set t = notasTrend|default(0) %}
          {% if t > 0 %}+{{ t }}%{% elseif t < 0 %}{{ t }}%{% else %}sin cambio{% endif %} vs mes ant.
        </div>
      </div>
    </div>

    <div class="kpi-card c-azul">
      <i class="bi bi-printer kpi-icon"></i>
      <div class="kpi-body">
        <div class="kpi-value">{{ scansCount|default(0) }}</div>
        <div class="kpi-label">Escáner</div>
        <div class="kpi-trend">documentos digitalizados</div>
      </div>
    </div>

  </div>

  {# ── Gráficas: Estado (barras) + Módulo (dona) ───────────────── #}
  <div class="row g-3 mb-3">
    <div class="col-12 col-lg-7">
      <div class="dash-card h-100">
        <div class="dash-card-header">
          <span class="dash-card-title"><i class="bi bi-bar-chart-fill"></i> Documentos por Estado</span>
        </div>
        <div class="chart-box">
          <canvas id="chartEstados"></canvas>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-5">
      <div class="dash-card h-100">
        <div class="dash-card-header">
          <span class="dash-card-title"><i class="bi bi-pie-chart-fill"></i> Documentos por Módulo</span>
        </div>
        <div class="chart-box">
          <canvas id="chartModulos"></canvas>
        </div>
      </div>
    </div>
  </div>

  {# ── Gráfica semanal ──────────────────────────────────────────── #}
  <div class="dash-card mb-3">
    <div class="dash-card-header">
      <span class="dash-card-title"><i class="bi bi-bar-chart-line"></i> Actividad Semanal</span>
    </div>
    <div class="chart-box">
      <canvas id="weeklyActivityChart"></canvas>
    </div>
  </div>

  {# ── Circulares activas + CISAE próximos ──────────────────────── #}
  <div class="row g-3 mb-3">
    <div class="col-12 col-lg-6">
      <div class="dash-card h-100">
        <div class="dash-card-header">
          <span class="dash-card-title"><i class="bi bi-megaphone"></i> Circulares Activas</span>
          <a class="glass-btn primary" href="{{ path('app_circular_index') }}" style="font-size:.8rem;padding:.3rem .8rem">Ver todas</a>
        </div>
        {% if activeCirculares|length > 0 %}
          {% for c in activeCirculares %}
            <div class="d-flex align-items-center justify-content-between py-2 border-bottom" style="border-color:var(--border-color,rgba(0,0,0,.1))!important">
              <div>
                <strong>#{{ c.id }}</strong> · {{ c.title|default('Sin título')|slice(0,60) }}{% if c.title and c.title|length > 60 %}…{% endif %}
              </div>
              <span class="badge" style="background:rgba(165,127,44,.2);color:#a57f2c;border:1px solid #a57f2c">
                {{ c.date ? c.date|date('Y-m-d') : '—' }}
              </span>
            </div>
          {% endfor %}
        {% else %}
          <p class="text-muted text-center py-3" style="font-size:.9rem">Sin registros aún</p>
        {% endif %}
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="dash-card h-100">
        <div class="dash-card-header">
          <span class="dash-card-title"><i class="bi bi-exclamation-triangle"></i> CISAE — Próximos Vencimientos</span>
          <a class="glass-btn primary" href="{{ path('app_cisae_index') }}" style="font-size:.8rem;padding:.3rem .8rem">Ver todos</a>
        </div>
        {% if cisaiProximos|length > 0 %}
          <table class="dash-table">
            <thead><tr><th>Folio</th><th>Trámite</th><th>Área</th><th>Vence</th></tr></thead>
            <tbody>
              {% for r in cisaiProximos %}
                {% set hoy = "now"|date("U") %}
                {% set vence = r.fechaLimite ? r.fechaLimite|date("U") : null %}
                {% set urgente = vence and (vence - hoy) < 259200 %}{# < 3 días #}
                <tr {% if urgente %}style="background:rgba(200,30,30,.08)"{% endif %}>
                  <td class="fw-bold">{{ r.folio ?? '—' }}</td>
                  <td>{{ r.titulo|default('—')|slice(0,40) }}{% if r.titulo and r.titulo|length > 40 %}…{% endif %}</td>
                  <td>{{ r.area ?? '—' }}</td>
                  <td>
                    <span class="{{ urgente ? 'pill-badge archivado' : 'pill-badge en\\ trámite' }}">
                      {{ r.fechaLimite ? r.fechaLimite|date('d/m/Y') : '—' }}
                    </span>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="text-muted text-center py-3" style="font-size:.9rem">Sin vencimientos próximos</p>
        {% endif %}
      </div>
    </div>
  </div>

  {# ── Oficios Recientes ────────────────────────────────────────── #}
  <div class="dash-card mb-3">
    <div class="dash-card-header">
      <span class="dash-card-title"><i class="bi bi-clock-history"></i> Oficios Recientes</span>
      <a class="glass-btn primary" href="{{ path('app_oficio_index') }}" style="font-size:.8rem;padding:.3rem .8rem">Ver todos</a>
    </div>
    {% if recentOficios|length > 0 %}
      <div style="overflow-x:auto">
        <table class="dash-table">
          <thead><tr><th>ID</th><th>Asunto</th><th>Remitente</th><th>Fecha</th><th class="text-end">Acción</th></tr></thead>
          <tbody>
            {% for o in recentOficios %}
              <tr>
                <td class="fw-bold">{{ o.id }}</td>
                <td>{{ o.title|default('—')|slice(0,55) }}{% if o.title and o.title|length > 55 %}…{% endif %}</td>
                <td>{{ o.sender|default('—') }}</td>
                <td>{{ o.date ? o.date|date('Y-m-d') : '—' }}</td>
                <td class="text-end">
                  <a class="glass-btn primary" href="{{ path('app_oficio_show', {id:o.id}) }}" style="font-size:.78rem;padding:.25rem .6rem">Ver</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="text-muted text-center py-3" style="font-size:.9rem">Sin registros aún</p>
    {% endif %}
  </div>

  {# ── Acciones rápidas ────────────────────────────────────────── #}
  <div class="dash-card">
    <div class="dash-card-header">
      <span class="dash-card-title"><i class="bi bi-lightning-charge"></i> Acciones Rápidas</span>
    </div>
    <div class="quick-actions">
      <a href="{{ path('app_oficio_new') }}"          class="glass-btn primary"><i class="bi bi-plus-circle"></i> Nuevo Oficio</a>
      <a href="{{ path('app_correspondence_new') }}"  class="glass-btn primary"><i class="bi bi-plus-circle"></i> Nueva Correspondencia</a>
      <a href="{{ path('app_circular_new') }}"        class="glass-btn primary"><i class="bi bi-plus-circle"></i> Nueva Circular</a>
      <a href="{{ path('app_nota_informativa_new') }}" class="glass-btn primary"><i class="bi bi-plus-circle"></i> Nueva Nota</a>
      <a href="{{ path('app_scanner_new') }}"         class="glass-btn success"><i class="bi bi-printer"></i> Escanear Documento</a>
    </div>
  </div>

</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
  (function(){
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    Chart.defaults.color       = isDark ? '#b4bccb' : '#3d4457';
    Chart.defaults.borderColor = isDark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.06)';

    function showEmpty(id, msg) {
      const c = document.getElementById(id);
      if (!c) return;
      c.style.display = 'none';
      const p = document.createElement('p');
      p.className = 'text-muted text-center py-4';
      p.style.fontSize = '.88rem';
      p.textContent = msg || 'Sin registros aún';
      c.parentElement.appendChild(p);
    }

    const palette = ['#9b2247','#1e5b4f','#a57f2c','#c0392b','#6c3483','#2471a3','#148f77','#d4ac0d'];

    // ── Documentos por Estado (barras horizontales) ────────────────
    const stLabels = {{ statusDistribution|keys|json_encode|raw }};
    const stValues = {{ statusDistributionValues|json_encode|raw }};
    if (stValues.length > 0 && stValues.some(v => v > 0)) {
      new Chart(document.getElementById('chartEstados'), {
        type: 'bar',
        data: {
          labels: stLabels,
          datasets: [{
            label: 'Documentos',
            data: stValues,
            backgroundColor: palette.slice(0, stLabels.length),
            borderRadius: 6,
            borderSkipped: false,
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
        }
      });
    } else {
      showEmpty('chartEstados', 'Sin registros aún');
    }

    // ── Documentos por Módulo (dona) ───────────────────────────────
    const modLabels = {{ totalesPorModulo|keys|json_encode|raw }};
    const modValues = {{ totalesPorModuloValues|json_encode|raw }};
    if (modValues.some(v => v > 0)) {
      new Chart(document.getElementById('chartModulos'), {
        type: 'doughnut',
        data: {
          labels: modLabels,
          datasets: [{
            data: modValues,
            backgroundColor: palette.slice(0, modLabels.length),
            borderWidth: 3,
            borderColor: isDark ? '#0e1114' : '#f4f6fa',
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          cutout: '62%',
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 13, padding: 12 } }
          }
        }
      });
    } else {
      showEmpty('chartModulos', 'Sin registros aún');
    }

    // ── Actividad Semanal (barras agrupadas) ───────────────────────
    const w = {{ weeklyStats|json_encode|raw }};
    const hasWeekly = w.oficios.some(v=>v>0)||w.correspondences.some(v=>v>0)||w.circulares.some(v=>v>0);
    if (hasWeekly) {
      new Chart(document.getElementById('weeklyActivityChart'), {
        type: 'bar',
        data: {
          labels: w.labels,
          datasets: [
            { label:'Oficios',         data: w.oficios,         backgroundColor:'rgba(155,34,71,.8)',  borderRadius:6 },
            { label:'Correspondencias',data: w.correspondences, backgroundColor:'rgba(30,91,79,.8)',   borderRadius:6 },
            { label:'Circulares',      data: w.circulares,      backgroundColor:'rgba(165,127,44,.8)', borderRadius:6 },
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { position:'top', labels:{ boxWidth:12, padding:10 } } },
          scales: {
            y: { beginAtZero:true, ticks:{ precision:0 }, grid:{ color:'rgba(128,128,128,.1)' } },
            x: { grid:{ display:false } }
          }
        }
      });
    } else {
      showEmpty('weeklyActivityChart', 'Sin actividad registrada esta semana');
    }
  })();
  </script>
{% endblock %}
